# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Chứng thực CÔNG KHAI (không phải khoá riêng) của root CA nội bộ dùng cho chữ ký PAdES
# (src/lib/signing/pades.ts) — cố ý ngoại lệ khỏi *.pem ở trên để commit được, phục vụ admin/
# kiểm toán viên tải về import vào Acrobat cá nhân.
!public/rubber-erp-signing-root-ca.pem
!public/rubber-erp-signing-root-ca-v2.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# temp files
.tmp/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backups & temporary keys
backup.json
key-mapping.json

# Google Drive sync cache (khong thuoc du an)
.tmp.driveupload/
.tmp.drivedownload/

# Office & editor temporary lock files
~$*
*.tmp

# Files khong can thiet trong cung_cap_dl (tai lieu tham khao, anh preview, bao cao)
cung_cap_dl/preview_*
cung_cap_dl/BAO_CAO_*
cung_cap_dl/*.docx
cung_cap_dl/*.xlsx
cung_cap_dl/*.pdf
cung_cap_dl/*.txt
cung_cap_dl/tab_ton_ls.png
cung_cap_dl/dieu_xe.jpg
cung_cap_dl/man_ky.png
cung_cap_dl/tieu_de.png


